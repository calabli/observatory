{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "观测台",
  "version": "0.1.7",
  "identifier": "local.observatory.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5188",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "观测台 · Observatory",
        "width": 1320,
        "height": 920,
        "minWidth": 820,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:5188 ws://127.0.0.1:5188"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "targets": ["nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyMzA4MjA5MkRFNDY5RkUKUldUK2FlUXRDWUl3RWxZeXg4M0NuRHlMQXlNbHR5d2o3aVYwdGRRUnZOSU5oa2lIbXVwb2YwUjgK",
      "endpoints": ["https://github.com/calabli/observatory/releases/latest/download/latest.json"]
    }
  }
}
