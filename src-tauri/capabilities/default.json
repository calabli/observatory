{
  "identifier": "main",
  "description": "Observatory main window (desktop)",
  "platforms": ["macOS", "windows", "linux"],
  "windows": ["main", "tray-panel"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "core:window:allow-set-fullscreen",
    "updater:default",
    "process:allow-restart"
  ]
}
