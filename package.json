{
  "name": "observatory-desktop",
  "private": true,
  "version": "0.1.17",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "vite --host 127.0.0.1 --port 5188 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5188 --strictPort",
    "native:build": "node scripts/native-build.mjs",
    "native:test": "node scripts/native-build.mjs test",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --debug --no-bundle",
    "desktop:release": "tauri build --no-bundle",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.2.6",
    "@tanstack/react-query": "^5.90.3",
    "@tauri-apps/api": "~2.12.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "lucide-react": "0.542.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^22.20.5",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "prettier": "^3.6.2",
    "typescript": "5.9.2",
    "vite": "7.3.0"
  }
}
